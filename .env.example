# Canonical production origin. Used for canonical URLs, Open Graph URLs,
# robots.txt, the sitemap and the generated .htaccess.
# Origin only — no path, no trailing slash.
NEXT_PUBLIC_SITE_URL=https://onlan.com.ua

# Indexing override. Leave unset in normal use: production builds are indexable,
# `next dev` and non-production builds are not.
#   false → noindex + `Disallow: /` (staging / preview hosts)
#   true  → force indexing (only ever on the real production host)
# NEXT_PUBLIC_SEO_INDEXING=false

# GTM container ID for client-side analytics initialisation (optional).
# NEXT_PUBLIC_GTM_ID=

# Where the contacts form should post (see the contacts page).
# NEXT_PUBLIC_CONTACT_FORM_URL=
# NEXT_PUBLIC_CONTACT_EMAIL=
